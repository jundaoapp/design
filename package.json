{
  "name": "@jundao/design",
  "type": "module",
  "version": "0.0.0-development",
  "description": "A simple, fast and modern SolidJS UI library.",
  "scripts": {
    "check": "pnpm biome check src/",
    "format": "pnpm biome format src/ --write",
    "check-typescript": "tsc --noEmit",
    "storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider storybook dev -p 4000 --no-open",
    "build-storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider storybook build && cp .storybook/favicon.ico storybook-static",
    "ca": "pnpm format && pnpm check && pnpm check-typescript",
    "build": "tsup"
  },
  "homepage": "https://github.com/jundaoapp/design",
  "bugs": {
    "url": "https://github.com/jundaoapp/design/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jundaoapp/design.git"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./index.css": "./dist/index.css"
  },
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "2.0.0",
    "@chromatic-com/storybook": "^4.0.0",
    "@kachurun/storybook-solid-vite": "^9.0.11",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^9.0.2",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "@solid-devtools/overlay": "^0.6.0",
    "@solidjs/meta": "^0.28.2",
    "@solidjs/router": "^0.8.0",
    "@storybook/addon-a11y": "9.0.12",
    "@storybook/addon-docs": "9.0.12",
    "@storybook/addon-links": "9.0.12",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "react-dom": "^19.1.0",
    "resolve": "^1.22.1",
    "semantic-release": "^20.1.1",
    "solid-devtools": "^0.26.0",
    "solid-js": "^1.8.5",
    "storybook": "9.0.12",
    "tsup": "^8.5.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@kobalte/core": "^0.11.2",
    "@neodrag/solid": "^2.3.1",
    "@solid-primitives/autofocus": "^0.0.100",
    "@solid-primitives/event-listener": "^2.4.1",
    "@solid-primitives/media": "^2.3.1",
    "@solid-primitives/props": "^3.1.1",
    "@solid-primitives/refs": "^1.0.5",
    "intl-messageformat": "10.7.16",
    "solid-icons": "^1.1.0",
    "solid-transition-group": "^0.0.12"
  },
  "peerDependencies": {
    "solid-js": "^1.6.6"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "webpack",
        "react",
        "react-dom"
      ],
      "allowedVersions": {
        "rollup": "3",
        "vite": "4",
        "esbuild": "0.17.8",
        "@solidjs/router": "0.8"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "alpha"
  },
  "browser": {},
  "typesVersions": {},
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
